# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in your Supabase project: Settings -> API Keys
# (the key may be labeled "anon public" or "publishable" depending on
# when your project was created — either one goes here).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Secret key (Settings -> API Keys -> Secret keys). Full database access,
# bypasses all security rules — never share this or expose it to the browser.
SUPABASE_SECRET_KEY=your-secret-key

# The email of the account that should see the admin "confirm orders"
# section on /orders. Use the email you registered with on the site itself.
ADMIN_EMAIL=you@example.com

# Telegram bot that sends you a message for every new order.
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts, copy the token.
# 2. Send any message to your new bot (search its username, tap Start).
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in a browser and
#    copy the numeric "id" under "chat" — that's your TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id
